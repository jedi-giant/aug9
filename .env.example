# Required for language-model planning, memory extraction, and embeddings.
OPENAI_API_KEY=

# OneMap account credentials and API root.
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Use "rule" for deterministic local planning or configure the supported LLM mode.
PLANNER_MODE=rule

# Local SQLite is used when DATABASE_URL is empty.
AUG9_DB_PATH=aug9.db
DATABASE_URL=

# Comma-separated browser origins allowed to call the public API.
CORS_ALLOWED_ORIGINS=https://aug-nudge-now.base44.app

# Bounded OpenAI client behavior for ambiguous planning and explicit memory updates.
OPENAI_TIMEOUT_SECONDS=12
OPENAI_MAX_RETRIES=0
